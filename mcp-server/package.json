{
  "name": "arca-mcp",
  "version": "0.1.1",
  "mcpName": "io.github.Ark-IA/arca-mcp",
  "description": "Model Context Protocol (MCP) server for ARCA — drive your self-hosted WhatsApp CRM, its custom objects and its CRM records from Claude, Cursor, and other MCP clients.",
  "license": "MIT",
  "author": "ARK-IA",
  "contributors": [
    "Arnas Donauskas (wacrm, the project this is built on)"
  ],
  "homepage": "https://github.com/Ark-IA/Arca",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ark-IA/Arca.git",
    "directory": "mcp-server"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "arca",
    "wacrm",
    "whatsapp",
    "crm",
    "claude",
    "ai"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "arca-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.7.0"
  }
}
