# The base URL of your ARCA instance (no trailing slash).
ARCA_BASE_URL=https://your-crm.example.com

# An ARCA API key. Create one in the dashboard:
#   Settings → API keys → New API key.
# The key's scopes decide what the server can do — grant the minimum.
# El prefijo de la clave sigue siendo wacrm_live_: está guardado en
# la base y se valida en cada petición, así que renombrarlo invalidaría
# todas las claves ya emitidas.
ARCA_API_KEY=wacrm_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Write guards (opt-in) ------------------------------------------
# By default the server is READ-ONLY: it never exposes tools that
# change data or send messages, no matter what the API key allows.
# Turn these on deliberately.

# Expose contact create/update and single-message sending.
# ARCA_ENABLE_WRITES=true

# Expose the broadcast tool (mass sends — highest risk). Requires
# ARCA_ENABLE_WRITES as well.
# ARCA_ENABLE_BROADCASTS=true

# Expose the delete tools (custom-object records, companies, tasks,
# notes, calendar events, deals). Deletes are permanent and have no
# undo, so they are the one capability kept off even when writes are
# on. Requires ARCA_ENABLE_WRITES as well.
# ARCA_ENABLE_DELETES=true

# The older WACRM_* spellings of every variable above are still
# accepted, so a config written before the rename keeps working.
# ARCA_* wins when both are set.
